{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.title'|trans }}{% endblock %}

{% block body %}
    <div class="md-login">
        <h1>{{ 'password_reset.title'|trans }}</h1>
        <p>{{ 'password_reset.intro'|trans }}</p>

        {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_rest(form) }}
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'password_reset.submit'|trans }}</button>
        {{ form_end(form) }}
        <p><a href="{{ path('app_login') }}">{{ 'login.title'|trans }}</a></p>
    </div>
{% endblock %}
