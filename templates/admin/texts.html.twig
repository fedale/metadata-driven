{% extends 'base.html.twig' %}

{% block title %}Texts · Translations · Admin{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; Objects</a></p>
    <div class="md-page__header">
        <h1>Translations <span class="gv-muted">· Texts</span></h1>
        {{ include('admin/_languages_nav.html.twig', {current: 'texts'}) }}
    </div>
    <p class="gv-muted">
        Texts of your own, for the layouts: a <code>{t:name}</code> token in a form view, a composite form or a grid
        heading shows the text of that name in the language of the user. Each text is written here in every language;
        the {{ default_locale|locale_name('en')|capitalize }} one is required and shows wherever another is missing.
        Empty it to remove the text, once no token places it.
    </p>

    {% if texts is empty %}
        <p class="gv-muted">No texts yet.</p>
    {% else %}
        {{ form_start(form, {attr: {class: 'md-form md-form--wide', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <table class="md-table md-texts">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        {% for locale in locales %}
                            <th scope="col">{{ locale|locale_name('en')|capitalize }}{{ locale == default_locale ? ' (required)' }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for index, text in texts %}
                        <tr>
                            <td>
                                <code>{t:{{ text.name }}}</code>
                                <div class="gv-muted md-texts__used">{{ text.usedBy is empty ? 'Not placed yet' : 'In ' ~ text.usedBy|join(', ') }}</div>
                            </td>
                            {% for locale in locales %}
                                {% set input = form['x' ~ index ~ '_' ~ locale] %}
                                <td>{{ form_widget(input, {attr: {'aria-label': text.name ~ ' (' ~ locale ~ ')'}}) }}{{ form_errors(input) }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <button type="submit" class="gv-btn gv-btn-primary">Save</button>
        {{ form_end(form) }}
    {% endif %}

    <section class="md-admin__section">
        <h2>New text</h2>
        {{ form_start(new_text, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
            {{ form_errors(new_text) }}
            {{ form_rest(new_text) }}
            <button type="submit" class="gv-btn">Create</button>
        {{ form_end(new_text) }}
    </section>
{% endblock %}
