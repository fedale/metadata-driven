{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.translation.texts'|trans }} · {{ 'admin.translations'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; {{ 'admin.objects'|trans }}</a></p>
    <div class="md-page__header">
        <h1>{{ 'admin.translations'|trans }} <span class="gv-muted">· {{ 'admin.translation.texts'|trans }}</span></h1>
        {{ include('admin/_languages_nav.html.twig', {current: 'texts'}) }}
    </div>
    <p class="gv-muted">
        {{ 'admin.translation.texts_intro'|trans({'%original%': default_locale|locale_name(app.request.locale)|capitalize|e})|raw }}
    </p>

    {% if texts is empty %}
        <p class="gv-muted">{{ 'admin.translation.no_texts'|trans }}</p>
    {% else %}
        {{ form_start(form, {attr: {class: 'md-form md-form--wide', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <table class="md-table md-texts">
                <thead>
                    <tr>
                        <th scope="col">{{ 'admin.name'|trans }}</th>
                        {% for locale in locales %}
                            {% set language = locale|locale_name(app.request.locale)|capitalize %}
                            <th scope="col">{{ locale == default_locale ? 'admin.translation.required_language'|trans({'%language%': language}) : language }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for index, text in texts %}
                        <tr>
                            <td>
                                <code>{t:{{ text.name }}}</code>
                                <div class="gv-muted md-texts__used">{{ text.usedBy is empty ? 'admin.translation.not_placed'|trans : 'admin.translation.placed_in'|trans({'%uses%': text.usedBy|join(', ')}) }}</div>
                            </td>
                            {% for locale in locales %}
                                {% set input = form['x' ~ index ~ '_' ~ locale] %}
                                <td>{{ form_widget(input, {attr: {'aria-label': text.name ~ ' (' ~ locale ~ ')'}}) }}{{ form_errors(input) }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.save'|trans }}</button>
        {{ form_end(form) }}
    {% endif %}

    <section class="md-admin__section">
        <h2>{{ 'admin.translation.new_text'|trans }}</h2>
        {{ form_start(new_text, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
            {{ form_errors(new_text) }}
            {{ form_rest(new_text) }}
            <button type="submit" class="gv-btn">{{ 'admin.create'|trans }}</button>
        {{ form_end(new_text) }}
    </section>
{% endblock %}
