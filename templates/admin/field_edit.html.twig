{% extends 'base.html.twig' %}

{% block title %}{{ field.label }} · {{ object.labelPlural }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_object_show', {object: object.name}) }}">&larr; {{ object.labelPlural }}</a></p>
    <h1>{{ field.label }} <span class="gv-muted">· <code>{{ object.name }}.{{ field.name }}</code></span></h1>

    <dl class="md-facts">
        <dt>Type</dt><dd>{{ type.label }}</dd>
        <dt>Column</dt><dd><code>data.{{ object.tableName }}.{{ field.columnName }}</code></dd>
        <dt>Rules</dt><dd>{{ field.isRequired ? 'required' : 'optional' }}{{ field.isUnique ? ', unique' : '' }}</dd>
        <dt>Settings</dt><dd><code class="md-settings">{{ field.settings|json_encode }}</code></dd>
        <dt>Applies</dt><dd>{{ field.condition ? 'when ' ~ field.condition.field ~ ' is ' ~ field.condition.values|join(' or ') : 'always' }}</dd>
    </dl>
    <p class="gv-muted">The type and the rules are fixed once the column exists, and so are the settings that shape it; the label, the other settings, the condition and the machine name can change.</p>

    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="gv-btn gv-btn-primary">Save</button>
    {{ form_end(form) }}

    {% if settings_form.settings|length > 0 %}
        <section class="md-admin__section">
            <h2>Settings</h2>
            {{ form_start(settings_form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(settings_form) }}
                {{ form_errors(settings_form.settings) }}
                {{ form_widget(settings_form.settings) }}
                {{ form_rest(settings_form) }}
                <button type="submit" class="gv-btn gv-btn-primary">Save settings</button>
            {{ form_end(settings_form) }}
        </section>
    {% else %}
        {% do settings_form.settings.setRendered %}
    {% endif %}

    <section class="md-admin__section">
        <h2>Condition</h2>
        <p class="gv-muted">Show the field only while another field holds some values. Hidden, it is not required, and its value is emptied when the record is saved.</p>
        {{ form_start(condition_form, {attr: {class: 'md-form'}}) }}
            {{ form_rest(condition_form) }}
            <button type="submit" class="gv-btn gv-btn-primary">Save condition</button>
        {{ form_end(condition_form) }}
    </section>

    <section class="md-admin__section">
        <h2>Machine name</h2>
        {{ form_start(rename_form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
            {{ form_rest(rename_form) }}
            <button type="submit" class="gv-btn gv-btn-primary">Rename</button>
        {{ form_end(rename_form) }}
    </section>

    <section class="md-admin__section md-admin__section--danger">
        <h2>Archive</h2>
        <p class="gv-muted">Takes the field out of the forms, the grids and the validation. The column and its values are kept, and it can be restored from the page of the object. Refused while a view, a composite form, a condition or a cascade uses it.</p>
        {{ form_start(archive_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'Archive the field ' ~ field.label ~ '? Its values are kept.'}}) }}
            <button type="submit" class="gv-btn gv-btn-danger">Archive {{ field.label|lower }}</button>
        {{ form_end(archive_form) }}
    </section>
{% endblock %}
