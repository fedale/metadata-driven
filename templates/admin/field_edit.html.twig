{% extends 'base.html.twig' %}

{% block title %}{{ field.label }} · {{ object.labelPlural }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_object_show', {object: object.name}) }}">&larr; {{ object.labelPlural }}</a></p>
    <h1>{{ field.label }} <span class="gv-muted">· <code>{{ object.name }}.{{ field.name }}</code></span></h1>

    <dl class="md-facts">
        <dt>{{ 'admin.type'|trans }}</dt><dd>{{ field_type_label(type) }}</dd>
        <dt>{{ 'admin.column'|trans }}</dt><dd><code>data.{{ object.tableName }}.{{ field.columnName }}</code></dd>
        <dt>{{ 'admin.rules'|trans }}</dt><dd>{{ (field.isRequired ? 'admin.rule.required' : 'admin.rule.optional')|trans }}{{ field.isUnique ? ', ' ~ 'admin.rule.unique'|trans }}</dd>
        <dt>{{ 'admin.settings'|trans }}</dt><dd><code class="md-settings">{{ field.settings|json_encode }}</code></dd>
        <dt>{{ 'admin.field.applies'|trans }}</dt><dd>
            {%- if field.condition -%}
                {{ 'admin.field.applies_when'|trans({'%field%': field.condition.field, '%values%': field.condition.values|join('admin.field.applies_or'|trans)}) }}
            {%- else -%}
                {{ 'admin.field.applies_always'|trans }}
            {%- endif -%}
        </dd>
    </dl>
    <p class="gv-muted">{{ 'admin.field.fixed_help'|trans }}</p>

    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.save'|trans }}</button>
    {{ form_end(form) }}

    {% if settings_form.settings|length > 0 %}
        <section class="md-admin__section">
            <h2>{{ 'admin.settings'|trans }}</h2>
            {{ form_start(settings_form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(settings_form) }}
                {{ form_errors(settings_form.settings) }}
                {{ form_widget(settings_form.settings) }}
                {{ form_rest(settings_form) }}
                <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.field.save_settings'|trans }}</button>
            {{ form_end(settings_form) }}
        </section>
    {% else %}
        {% do settings_form.settings.setRendered %}
    {% endif %}

    <section class="md-admin__section">
        <h2>{{ 'admin.field.condition'|trans }}</h2>
        <p class="gv-muted">{{ 'admin.field.condition_help'|trans }}</p>
        {{ form_start(condition_form, {attr: {class: 'md-form'}}) }}
            {{ form_rest(condition_form) }}
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.field.save_condition'|trans }}</button>
        {{ form_end(condition_form) }}
    </section>

    <section class="md-admin__section">
        <h2>{{ 'admin.machine_name'|trans }}</h2>
        {{ form_start(rename_form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
            {{ form_rest(rename_form) }}
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.rename'|trans }}</button>
        {{ form_end(rename_form) }}
    </section>

    <section class="md-admin__section md-admin__section--danger">
        <h2>{{ 'admin.archive'|trans }}</h2>
        <p class="gv-muted">{{ 'admin.field.archive_help'|trans }}</p>
        {{ form_start(archive_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'admin.field.archive_confirm'|trans({'%field%': field.label})}}) }}
            <button type="submit" class="gv-btn gv-btn-danger">{{ 'admin.field.archive_button'|trans({'%field%': field.label|lower}) }}</button>
        {{ form_end(archive_form) }}
    </section>
{% endblock %}
