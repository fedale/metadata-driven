{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.tables.adopt_title'|trans({'%table%': table}) }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_table_show', {table: table}) }}">&larr; <code>{{ data_schema }}.{{ table }}</code></a></p>
    <h1>{{ 'admin.tables.adopt_title'|trans({'%table%': table}) }}</h1>
    <p class="gv-muted">{{ 'admin.tables.adopt_help'|trans }}</p>

    {% set candidates = set|filter(name => name != table)|merge(related.pointedAt)|merge(related.pointing) %}
    {% if candidates is not empty %}
        {# A GET form: choosing the tables reloads the page with them. #}
        <form method="get" class="md-form" data-turbo="false">
            <fieldset>
                <legend>{{ 'admin.tables.with'|trans }}</legend>
                <p class="gv-muted">{{ 'admin.tables.with_help'|trans }}</p>
                <input type="hidden" name="with[]" value="">
                {% for name in candidates %}
                    <label class="md-check">
                        <input type="checkbox" name="with[]" value="{{ name }}"{% if name in set %} checked{% endif %}>
                        <code>{{ name }}</code>
                        <span class="gv-muted">{{ (name in related.pointing ? 'admin.tables.pointed_at' : 'admin.tables.points_here')|trans }}</span>
                    </label>
                {% endfor %}
                <button type="submit" class="gv-btn">{{ 'admin.tables.update_set'|trans }}</button>
            </fieldset>
        </form>
    {% endif %}

    {% if reasons is not empty %}
        <div class="md-flash md-flash--error">
            <p>{{ 'admin.tables.not_adopted'|trans }}</p>
            <ul>{% for reason in reasons %}<li>{{ reason|message }}</li>{% endfor %}</ul>
        </div>
    {% elseif reports is not empty %}
        <div class="md-flash md-flash--success">
            <p>{{ 'admin.tables.tried'|trans({'%name%': reports|map(report => report.objectName)|join(', ')}) }}</p>
        </div>
        {% for report in reports %}
            <h2><code>{{ report.objectName }}</code></h2>
            <ul class="md-sql">
                {% for statement in report.statements %}<li><code>{{ statement }}</code></li>{% endfor %}
            </ul>
        {% endfor %}
    {% endif %}

    {# Without Turbo: "Try it" answers its POST with the page itself (200), which Turbo Drive
       would not show, as it wants a form's answer to redirect. #}
    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
        {{ form_errors(form) }}
        {% for proposal in proposals %}
            {% set t = form['t' ~ loop.index0] %}
            <section class="md-admin__section">
                <h2><code>{{ data_schema }}.{{ proposal.table.name }}</code></h2>
                {% if proposal.junction %}
                    <fieldset>
                        <legend>{{ 'admin.tables.junction'|trans({'%source%': proposal.junction.sourceColumn, '%target%': proposal.junction.targetColumn}) }}</legend>
                        <p class="gv-muted">{{ 'admin.tables.junction_help'|trans }}</p>
                        {{ form_row(t.junction.mode) }}
                        {{ form_row(t.junction.field) }}
                        {{ form_row(t.junction.label) }}
                    </fieldset>
                {% endif %}
                <fieldset>
                    <legend>{{ 'admin.tables.the_object'|trans }}</legend>
                    {{ form_row(t.name) }}
                    {{ form_row(t.labelSingular) }}
                    {{ form_row(t.labelPlural) }}
                    <p>{{ 'admin.object.key_type'|trans }}: {{ ('admin.object.key.' ~ proposal.keyType.value)|trans }} ({{ 'admin.tables.from_key'|trans({'%column%': proposal.table.primaryKey|first}) }})</p>
                </fieldset>

                <table class="md-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'admin.tables.column'|trans }}</th>
                            <th scope="col">{{ 'admin.tables.type'|trans }}</th>
                            <th scope="col">{{ 'admin.tables.field_type'|trans }}</th>
                            <th scope="col">{{ 'admin.machine_name'|trans }}</th>
                            <th scope="col">{{ 'admin.tables.label'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for column in proposal.columns %}
                            {% set row = t.columns['c' ~ loop.index0] %}
                            <tr>
                                <td><code>{{ column.column.name }}</code></td>
                                <td><code>{{ column.column.type }}</code></td>
                                <td>{{ form_widget(row.type) }}</td>
                                <td>{{ form_widget(row.field) }}</td>
                                <td>{{ form_widget(row.label) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endfor %}
        <p class="gv-muted">{{ 'admin.tables.what_changes'|trans({'%table%': table}) }}</p>

        {{ form_row(form.try, {attr: {class: 'gv-btn'}}) }}
        {{ form_row(form.adopt, {attr: {class: 'gv-btn gv-btn-primary'}}) }}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
