{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.workflow.secrets'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_workflow_index') }}">&larr; {{ 'admin.workflows'|trans }}</a></p>
    <h1>{{ 'admin.workflow.secrets'|trans }}</h1>
    <p class="gv-muted">{{ 'admin.workflow.secrets_intro'|trans }}</p>

    {% if secrets is empty %}
        <p class="gv-muted">{{ 'admin.workflow.secrets_empty'|trans }}</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.workflow.secret_name'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.secret_use'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.secret_updated'|trans }}</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {% for secret in secrets %}
                    <tr>
                        <td><code>{{ secret.name }}</code></td>
                        <td><code>{{ '{{ $secrets.' ~ secret.name ~ ' }}' }}</code></td>
                        <td>{{ secret.updated_at|slice(0, 16) }}{% if secret.updated_by %} · {{ secret.updated_by }}{% endif %}</td>
                        <td>
                            {{ form_start(secret.delete, {attr: {class: 'md-inline-form', 'data-turbo-confirm': 'admin.workflow.secret_delete_confirm'|trans({'%name%': secret.name})}}) }}
                                <button type="submit" class="gv-btn gv-btn-sm gv-btn-danger">{{ 'admin.delete'|trans }}</button>
                            {{ form_end(secret.delete) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>{{ 'admin.workflow.secret_new'|trans }}</h2>
    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate', autocomplete: 'off'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.workflow.secret_save'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
