{% extends 'base.html.twig' %}

{% set original = default_locale|locale_name('en')|capitalize %}
{% set language = locale|locale_name('en')|capitalize %}

{% block title %}{{ language }} · Translations · Admin{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; Objects</a></p>
    <div class="md-page__header">
        <h1>Translations <span class="gv-muted">· {{ language }}</span></h1>
        {{ include('admin/_languages_nav.html.twig', {current: locale}) }}
    </div>
    <p class="gv-muted">
        The metadata is written in {{ original }}. Here its labels get their {{ language }} text, shown to the users
        reading the application in {{ language }}; a key left empty shows the {{ original }} text, in grey inside the input.
        The {{ original }} text is changed where it is defined: follow its link. The texts of the layouts
        (<code>{t:name}</code>) are under <a href="{{ path('admin_text_index') }}">Texts</a>.
    </p>

    {% if groups is empty %}
        <p class="gv-muted">Nothing to translate yet.</p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'md-form md-form--wide', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% for group, rows in groups %}
            <section class="md-admin__section">
                <h2>{{ group }}</h2>
                <table class="md-table md-translations">
                    <thead>
                        <tr>
                            <th scope="col">Key</th>
                            <th scope="col">{{ original }} (original)</th>
                            <th scope="col">{{ language }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, row in rows %}
                            {% set input = form['t' ~ index] %}
                            <tr>
                                <td><label for="{{ input.vars.id }}"><code>{{ row.entry.key }}</code></label></td>
                                <td>
                                    {{ row.entry.source }}
                                    {% if row.edit_url %}<a class="md-translations__edit" href="{{ row.edit_url }}" title="Change the {{ original }} text">Edit</a>{% endif %}
                                </td>
                                <td>{{ form_widget(input) }}{{ form_errors(input) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endfor %}
        {% if groups is not empty %}
            <button type="submit" class="gv-btn gv-btn-primary">Save</button>
        {% endif %}
    {{ form_end(form) }}
{% endblock %}
