{% extends 'base.html.twig' %}

{# Language names in the language of the page: "Italian" in English, "italiano" in Italian. #}
{% set original = default_locale|locale_name(app.request.locale)|capitalize %}
{% set language = locale|locale_name(app.request.locale)|capitalize %}
{% set heading = 'admin.translation.metadata_into'|trans({'%language%': language}) %}

{% block title %}{{ heading }} · {{ 'admin.translations'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; {{ 'admin.objects'|trans }}</a></p>
    <div class="md-page__header">
        <h1>{{ 'admin.translations'|trans }} <span class="gv-muted">· {{ heading }}</span></h1>
        {{ include('admin/_languages_nav.html.twig', {current: 'metadata'}) }}
    </div>
    {% if targets|length > 1 %}
        {# One language at a time: the inputs of a page are those of one language. #}
        <nav class="md-switch md-translations__languages" aria-label="{{ 'admin.translation.language'|trans }}">
            {% for item in targets %}
                <a class="md-switch__item{{ locale == item ? ' md-switch__item--current' }}" href="{{ path('admin_translation_edit', {locale: item}) }}"
                   {% if locale == item %}aria-current="page"{% endif %}>{{ item|locale_name(app.request.locale)|capitalize }}</a>
            {% endfor %}
        </nav>
    {% endif %}
    <p class="gv-muted">
        {{ 'admin.translation.intro'|trans({'%original%': original|e, '%language%': language|e, '%texts%': path('admin_text_index')|e})|raw }}
    </p>

    {% if groups is empty %}
        <p class="gv-muted">{{ 'admin.translation.nothing'|trans }}</p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'md-form md-form--wide', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% for group, rows in groups %}
            <section class="md-admin__section">
                <h2>{{ group }}</h2>
                <table class="md-table md-translations">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'admin.translation.key'|trans }}</th>
                            <th scope="col">{{ 'admin.translation.original'|trans({'%language%': original}) }}</th>
                            <th scope="col">{{ language }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, row in rows %}
                            {% set input = form['t' ~ index] %}
                            <tr>
                                <td><label for="{{ input.vars.id }}"><code>{{ row.entry.key }}</code></label></td>
                                <td>
                                    {{ row.entry.source }}
                                    {% if row.edit_url %}<a class="md-translations__edit" href="{{ row.edit_url }}" title="{{ 'admin.translation.change_original'|trans({'%language%': original}) }}">{{ 'admin.edit'|trans }}</a>{% endif %}
                                </td>
                                <td>{{ form_widget(input) }}{{ form_errors(input) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endfor %}
        {% if groups is not empty %}
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.save'|trans }}</button>
        {% endif %}
    {{ form_end(form) }}
{% endblock %}
