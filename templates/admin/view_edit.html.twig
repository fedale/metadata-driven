{% extends 'base.html.twig' %}

{% set heading = view ? 'View ' ~ view.name : 'New view' %}

{% block title %}{{ heading }} · {{ object.labelPlural }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_object_show', {object: object.name}) }}">&larr; {{ object.labelPlural }}</a></p>
    <h1>{{ heading }} <span class="gv-muted">· <code>{{ object.name }}</code></span></h1>

    {% if view %}
        <dl class="md-facts">
            <dt>Used for</dt><dd>{{ view.kind.value }}</dd>
            <dt>Preview</dt><dd><a href="{{ path('record_new', {object: object.name, view: view.name}) }}">New {{ object.labelSingular|lower }} with this view</a></dd>
        </dl>
    {% endif %}

    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="gv-btn gv-btn-primary">Save</button>
    {{ form_end(form) }}

    {% if delete_form is defined %}
        {{ form_start(delete_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'Delete the view ' ~ view.name ~ '?'}}) }}
            <button type="submit" class="gv-btn gv-btn-danger">Delete</button>
        {{ form_end(delete_form) }}
    {% endif %}
{% endblock %}
