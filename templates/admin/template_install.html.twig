{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.template_admin.install_title'|trans({'%template%': template}) }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_template_index') }}">&larr; {{ 'admin.templates'|trans }}</a></p>
    <h1>{{ 'admin.template_admin.install_heading'|trans({'%template%': template|e})|raw }}</h1>

    {% if reasons is not empty %}
        <div class="md-flash md-flash--error" role="alert">
            <p>{{ 'admin.template_admin.cannot_install'|trans }}</p>
            <ul>{% for reason in reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
        </div>
    {% elseif reports is not empty %}
        {% set last = reports|last %}
        {% set many = reports|length > 1 %}
        {% if many %}
            <p>{{ 'admin.template_admin.requires_missing'|trans({'%name%': last.name}) }}</p>
        {% endif %}
        <p>{{ (many ? 'admin.template_admin.trial_many' : 'admin.template_admin.trial_one')|trans }}</p>
        {% for report in reports %}
            {% if many %}<h2>{{ report.name }} {{ report.version }}</h2><p class="gv-muted">{{ 'admin.template_admin.from_source'|trans({'%source%': report.source}) }}</p>{% endif %}
            <dl class="md-facts">
                <dt>{{ 'admin.objects'|trans }}</dt><dd>{{ report.objects|join(', ') }}</dd>
                <dt>{{ 'admin.fields'|trans }}</dt><dd>{{ report.fields }}</dd>
                <dt>{{ 'admin.views'|trans }}</dt><dd>{{ report.views }}</dd>
                <dt>{{ 'admin.forms'|trans }}</dt><dd>{{ report.forms is empty ? '—' : report.forms|join(', ') }}</dd>
                <dt>{{ 'admin.translations'|trans }}</dt><dd>{{ report.translations }}</dd>
                <dt>{{ 'admin.records'|trans }}</dt><dd>{{ report.records }}</dd>
            </dl>
            {% if report.skippedLocales is not empty %}
                <p class="gv-muted">{{ 'admin.template_admin.skipped_locales'|trans({'%locales%': report.skippedLocales|join(', ')}) }}</p>
            {% endif %}
        {% endfor %}
        {{ form_start(confirm) }}
            <button type="submit" class="gv-btn gv-btn-primary">{{ (many ? 'admin.template_admin.install_button_many' : 'admin.template_admin.install_button')|trans({'%name%': last.name, '%version%': last.version}) }}</button>
        {{ form_end(confirm) }}
    {% endif %}
{% endblock %}
