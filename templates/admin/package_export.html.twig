{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.package_admin.export_title'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_package_index') }}">&larr; {{ 'admin.packages'|trans }}</a></p>
    <h1>{{ 'admin.package_admin.export_title'|trans }}</h1>
    <p class="gv-muted">{{ 'admin.package_admin.export_help'|trans }}</p>

    {# Without Turbo: the answer is the archive to download, or the page with its errors. #}
    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
        {% if not form.vars.valid and form.vars.errors is not empty %}
            <div class="md-flash md-flash--error" role="alert">{{ form_errors(form) }}</div>
        {% endif %}
        <fieldset>
            <legend>{{ 'admin.package_admin.export_package'|trans }}</legend>
            {{ form_row(form.name) }}
            {{ form_row(form.version) }}
            {{ form_row(form.label) }}
            {{ form_row(form.description) }}
            {{ form_row(form.license) }}
        </fieldset>
        <fieldset><legend>{{ 'admin.objects'|trans }}</legend>{{ form_widget(form.objects) }}{{ form_errors(form.objects) }}</fieldset>
        <fieldset><legend>{{ form_label(form.seeds) }}</legend>{{ form_help(form.seeds) }}{{ form_widget(form.seeds) }}</fieldset>
        {% if form.forms.vars.choices is not empty %}
            <fieldset><legend>{{ 'admin.forms'|trans }}</legend>{{ form_widget(form.forms) }}</fieldset>
        {% else %}{% do form.forms.setRendered %}{% endif %}
        {% if form.workflows.vars.choices is not empty %}
            <fieldset><legend>{{ 'admin.workflows'|trans }}</legend>{{ form_help(form.workflows) }}{{ form_widget(form.workflows) }}</fieldset>
        {% else %}{% do form.workflows.setRendered %}{% endif %}
        <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.package_admin.export_button'|trans }}</button>
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
