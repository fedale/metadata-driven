{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.workflow.versions'|trans }} · {{ workflow.name }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_workflow_edit', {id: workflow.id.toRfc4122}) }}">&larr; {{ workflow.name }}</a></p>
    <h1>{{ 'admin.workflow.versions'|trans }}</h1>
    <table class="md-table">
        <thead>
            <tr>
                <th scope="col">{{ 'admin.workflow.version'|trans }}</th>
                <th scope="col">{{ 'admin.workflow.status'|trans }}</th>
                <th scope="col">{{ 'admin.workflow.activated_at'|trans }}</th>
                <th scope="col"><span class="md-visually-hidden">{{ 'admin.actions'|trans }}</span></th>
            </tr>
        </thead>
        <tbody>
            {% for row in versions %}
                <tr>
                    <td>{{ row.version.number }}</td>
                    <td>{{ ('admin.workflow.status_' ~ row.version.status.value)|trans }}</td>
                    <td>{% if row.version.activatedAt %}{{ row.version.activatedAt|date('Y-m-d H:i') }} · {{ row.version.activatedBy }}{% else %}<span class="gv-muted">—</span>{% endif %}</td>
                    <td>
                        {% if row.reuse %}
                            {{ form_start(row.reuse, {attr: {class: 'md-inline-form'}}) }}
                                <button type="submit" class="gv-btn gv-btn-sm">{{ 'admin.workflow.use_as_draft'|trans }}</button>
                            {{ form_end(row.reuse) }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
