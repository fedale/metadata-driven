{# The two pages of the translations: the labels of the metadata, and the texts of the {t:name} tokens. #}
<nav class="md-switch" aria-label="{{ 'admin.translations'|trans }}">
    <a class="md-switch__item{{ current == 'metadata' ? ' md-switch__item--current' }}" href="{{ path('admin_translation_index') }}"
       {% if current == 'metadata' %}aria-current="page"{% endif %}>{{ 'admin.translation.metadata'|trans }}</a>
    <a class="md-switch__item{{ current == 'texts' ? ' md-switch__item--current' }}" href="{{ path('admin_text_index') }}"
       {% if current == 'texts' %}aria-current="page"{% endif %}>{{ 'admin.translation.texts'|trans }}</a>
</nav>
