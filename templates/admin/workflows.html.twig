{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.workflows'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    {% if wf_console %}<p><a href="{{ path('console_index') }}">&larr; {{ 'console.workspaces'|trans }}</a></p>{% else %}<p><a href="{{ path('admin_index') }}">&larr; {{ 'admin.objects'|trans }}</a></p>{% endif %}
    <div class="md-page__header">
        <h1>{{ 'admin.workflows'|trans }}</h1>
        <span>
            {% if not wf_console %}<a class="gv-btn" href="{{ path('admin_workflow_secret_index') }}">{{ 'admin.workflow.secrets'|trans }}</a>{% endif %}
            <a class="gv-btn gv-btn-primary" href="{{ path(wf ~ 'new') }}">{{ 'admin.workflow.new'|trans }}</a>
        </span>
    </div>
    <p class="gv-muted">{{ 'admin.workflow.intro'|trans }}</p>

    {% if rows is empty %}
        <p class="gv-muted">{{ 'admin.workflow.empty'|trans }}</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.workflow.name'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.trigger'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.status'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.last_run'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.failed_day'|trans }}</th>
                    <th scope="col">{{ 'admin.workflow.order'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    {% set id = row.workflow.id.toRfc4122 %}
                    {% set runs = summary[id] ?? null %}
                    <tr>
                        <td><a href="{{ path(wf ~ 'edit', {id: id}) }}">{{ row.workflow.name }}</a></td>
                        <td>{% if row.trigger %}<code>{{ row.trigger }}</code>{% else %}<span class="gv-muted">—</span>{% endif %}</td>
                        <td>
                            {% if row.active %}{{ 'admin.workflow.active_version'|trans({'%number%': row.active.number}) }}{% else %}<span class="gv-muted">{{ 'admin.workflow.inactive'|trans }}</span>{% endif %}
                            {% if row.draft %}<br><span class="gv-muted">{{ 'admin.workflow.draft_version'|trans({'%number%': row.draft.number}) }}</span>{% endif %}
                        </td>
                        <td>{% if runs and runs.last %}<a href="{{ path(wf ~ 'runs', {id: id}) }}">{{ runs.last|slice(0, 16) }}</a>{% else %}<span class="gv-muted">—</span>{% endif %}</td>
                        <td>{% if runs and runs.failed > 0 %}<a href="{{ path(wf ~ 'runs', {id: id, status: 'failed'}) }}">{{ runs.failed }}</a>{% else %}0{% endif %}</td>
                        <td>
                            {{ form_start(row.move, {attr: {class: 'md-inline-form'}}) }}
                                {% if not loop.first %}{{ form_widget(row.move.up) }}{% else %}{% do row.move.up.setRendered %}{% endif %}
                                {% if not loop.last %}{{ form_widget(row.move.down) }}{% else %}{% do row.move.down.setRendered %}{% endif %}
                            {{ form_end(row.move) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="gv-muted">{{ 'admin.workflow.order_help'|trans }}</p>
    {% endif %}
{% endblock %}
