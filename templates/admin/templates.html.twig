{% extends 'base.html.twig' %}

{% block title %}Templates · Admin{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; Objects</a></p>
    <h1>Templates</h1>
    <p class="gv-muted">A template brings objects, their views and forms, their translations and their records. It is installed in one go, and upgraded later: only what its new version changed is applied, what was changed here is kept.</p>

    <h2>Installed</h2>
    {% if installed is empty %}
        <p class="gv-muted">No template is installed.</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">Template</th>
                    <th scope="col">Version</th>
                    <th scope="col">Installed</th>
                    <th scope="col">Upgraded</th>
                    <th scope="col">From</th>
                </tr>
            </thead>
            <tbody>
                {% for installation in installed %}
                    <tr>
                        <td><code>{{ installation.name }}</code></td>
                        <td>{{ installation.version }}</td>
                        <td>{{ installation.installedAt|date('Y-m-d H:i') }}</td>
                        <td>{{ installation.upgradedAt ? installation.upgradedAt|date('Y-m-d H:i') : '—' }}</td>
                        <td class="md-file__name">{{ installation.source }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Available</h2>
    {% if unreachable %}
        <p class="md-flash md-flash--error" role="alert">{{ unreachable }}</p>
    {% elseif available is empty %}
        <p class="gv-muted">The indexes offer no template{% if indexes is empty %}: add an index below{% endif %}.</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">Template</th>
                    <th scope="col">Newest version</th>
                    <th scope="col">Index</th>
                    <th scope="col"><span class="md-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for offer in available %}
                    {% set located = offer.located %}
                    {% set named = located.entry.name ~ '@' ~ located.entry.version %}
                    <tr>
                        <td><code>{{ located.entry.name }}</code></td>
                        <td>{{ located.entry.version }}</td>
                        <td>{{ located.source }}</td>
                        <td>
                            {% if offer.action == 'install' %}
                                <a href="{{ path('admin_template_install', {template: named, repo: located.source}) }}">Install…</a>
                            {% elseif offer.action == 'upgrade' %}
                                <a href="{{ path('admin_template_upgrade', {template: named, repo: located.source}) }}">Upgrade from {{ offer.installed }}…</a>
                            {% else %}
                                <span class="gv-muted">Installed</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Indexes</h2>
    {% if indexes is not empty %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Signed</th>
                    <th scope="col"><span class="md-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for index in indexes %}
                    <tr>
                        <td>{{ index.name }}</td>
                        <td class="md-file__name">{{ index.url }}</td>
                        <td>{{ index.key is null ? 'No: accepted unsigned' : 'Yes' }}</td>
                        <td>
                            {% if remove_forms[index.name] %}
                                {{ form_start(remove_forms[index.name], {action: path('admin_template_index_remove', {name: index.name}), attr: {'data-turbo-confirm': 'Remove the index "' ~ index.name ~ '"? What was installed from it stays.'}}) }}
                                    <button type="submit" class="gv-btn">Remove</button>
                                {{ form_end(remove_forms[index.name]) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h3>Add an index</h3>
    {{ form_start(add_form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(add_form) }}
        {{ form_rest(add_form) }}
        <button type="submit" class="gv-btn gv-btn-primary">Add the index</button>
    {{ form_end(add_form) }}
{% endblock %}
