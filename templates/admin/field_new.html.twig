{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.field.new_typed'|trans({'%type%': field_type_label(type)|lower}) }} · {{ object.labelPlural }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_field_type', {object: object.name}) }}">&larr; {{ 'admin.field.field_types'|trans }}</a></p>
    <h1>{{ 'admin.field.new_typed_on'|trans({'%type%': field_type_label(type)|lower, '%objects%': object.labelPlural}) }}</h1>
    <p class="gv-muted">{{ field_type_description(type) }}</p>

    {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.label) }}
        {{ form_row(form.required) }}
        {{ form_row(form.unique) }}
        {% if form.settings|length > 0 %}
            <fieldset>
                <legend>{{ 'admin.settings'|trans }}</legend>
                {{ form_errors(form.settings) }}
                {{ form_widget(form.settings) }}
            </fieldset>
        {% else %}
            {% do form.settings.setRendered %}
        {% endif %}
        <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.create'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
