{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.forms'|trans }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_index') }}">&larr; {{ 'admin.objects'|trans }}</a></p>
    <div class="md-page__header">
        <h1>{{ 'admin.forms'|trans }}</h1>
        <a class="gv-btn gv-btn-primary" href="{{ path('admin_form_new') }}">{{ 'admin.composite.new'|trans }}</a>
    </div>
    <p class="gv-muted">{{ 'admin.composite.intro'|trans }}</p>

    {% if forms is empty %}
        <p class="gv-muted">{{ 'admin.composite.empty'|trans }}</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.form_heading'|trans }}</th>
                    <th scope="col">{{ 'admin.machine_name'|trans }}</th>
                    <th scope="col">{{ 'admin.objects'|trans }}</th>
                    <th scope="col"><span class="md-visually-hidden">{{ 'admin.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for form in forms %}
                    <tr>
                        <td><a href="{{ path('admin_form_edit', {form: form.name}) }}">{{ form.label }}</a></td>
                        <td><code>{{ form.name }}</code></td>
                        <td>{{ form.root.objects|join(', ') }}</td>
                        <td><a href="{{ path('composite_new', {form: form.name}) }}">{{ 'admin.open'|trans }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
