{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Objects</h1>
        <div class="page-actions">
            <a class="button button-secondary" href="{{ path('admin_form_index') }}">Forms</a>
            <a class="button" href="{{ path('admin_object_new') }}">New object</a>
        </div>
    </div>

    {% if objects is empty %}
        <p class="muted">No objects yet. Create the first one: it gets its own table at once.</p>
    {% else %}
        <table class="records">
            <thead>
                <tr>
                    <th scope="col">Object</th>
                    <th scope="col">Machine name</th>
                    <th scope="col">Table</th>
                    <th scope="col">Fields</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for object in objects %}
                    <tr>
                        <td><a href="{{ path('admin_object_show', {object: object.name}) }}">{{ object.labelPlural }}</a></td>
                        <td><code>{{ object.name }}</code></td>
                        <td><code>data.{{ object.tableName }}</code></td>
                        <td>{{ object.fields|length }}</td>
                        <td><a href="{{ path('record_index', {object: object.name}) }}">Records</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
