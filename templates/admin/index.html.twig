{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block body %}
    <div class="md-page__header">
        <h1>Objects</h1>
        <div class="md-page__actions">
            <a class="gv-btn" href="{{ path('admin_form_index') }}">Forms</a>
            <a class="gv-btn" href="{{ path('admin_translation_index') }}">Translations</a>
            <a class="gv-btn gv-btn-primary" href="{{ path('admin_object_new') }}">New object</a>
        </div>
    </div>

    {% if objects is empty %}
        <p class="gv-muted">No objects yet. Create the first one: it gets its own table at once.</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">Object</th>
                    <th scope="col">Machine name</th>
                    <th scope="col">Table</th>
                    <th scope="col">Fields</th>
                    <th scope="col"><span class="md-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for object in objects %}
                    <tr>
                        <td><a href="{{ path('admin_object_show', {object: object.name}) }}">{{ object.labelPlural }}</a></td>
                        <td><code>{{ object.name }}</code></td>
                        <td><code>data.{{ object.tableName }}</code></td>
                        <td>{{ object.fields|length }}</td>
                        <td><a href="{{ path('record_index', {object: object.name}) }}">Records</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if archived is not empty %}
        <section class="md-admin__section">
            <h2>Archived</h2>
            <p class="gv-muted">Out of the application; their tables and records are kept, and their names stay taken. Restore one here; <code>metadata:purge</code> deletes one for good.</p>
            <table class="md-table">
                <thead>
                    <tr>
                        <th scope="col">Object</th>
                        <th scope="col">Machine name</th>
                        <th scope="col">Table</th>
                        <th scope="col"><span class="md-visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for name, entry in archived %}
                        <tr>
                            <td>{{ entry.object.labelPlural }}</td>
                            <td><code>{{ name }}</code></td>
                            <td><code>data.{{ entry.object.tableName }}</code></td>
                            <td>
                                {{ form_start(entry.restore_form) }}
                                    <button type="submit" class="gv-btn">Restore</button>
                                {{ form_end(entry.restore_form) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endif %}
{% endblock %}
