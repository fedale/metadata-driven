{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <div class="md-page__header">
        <h1>{{ 'admin.objects'|trans }}</h1>
        <div class="md-page__actions">
            <a class="gv-btn" href="{{ path('admin_form_index') }}">{{ 'admin.forms'|trans }}</a>
            <a class="gv-btn" href="{{ path('admin_translation_index') }}">{{ 'admin.translations'|trans }}</a>
            <a class="gv-btn" href="{{ path('admin_template_index') }}">{{ 'admin.templates'|trans }}</a>
            <a class="gv-btn gv-btn-primary" href="{{ path('admin_object_new') }}">{{ 'admin.index.new_object'|trans }}</a>
        </div>
    </div>

    {% if objects is empty %}
        <p class="gv-muted">{{ 'admin.index.empty'|trans }}</p>
    {% else %}
        <table class="md-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.object_heading'|trans }}</th>
                    <th scope="col">{{ 'admin.machine_name'|trans }}</th>
                    <th scope="col">{{ 'admin.table'|trans }}</th>
                    <th scope="col">{{ 'admin.fields'|trans }}</th>
                    <th scope="col"><span class="md-visually-hidden">{{ 'admin.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for object in objects %}
                    <tr>
                        <td><a href="{{ path('admin_object_show', {object: object.name}) }}">{{ object.labelPlural }}</a></td>
                        <td><code>{{ object.name }}</code></td>
                        <td><code>data.{{ object.tableName }}</code></td>
                        <td>{{ object.fields|length }}</td>
                        <td><a href="{{ path('record_index', {object: object.name}) }}">{{ 'admin.records'|trans }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if archived is not empty %}
        <section class="md-admin__section">
            <h2>{{ 'admin.index.archived'|trans }}</h2>
            <p class="gv-muted">{{ 'admin.index.archived_help'|trans|raw }}</p>
            <table class="md-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'admin.object_heading'|trans }}</th>
                        <th scope="col">{{ 'admin.machine_name'|trans }}</th>
                        <th scope="col">{{ 'admin.table'|trans }}</th>
                        <th scope="col"><span class="md-visually-hidden">{{ 'admin.actions'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for name, entry in archived %}
                        <tr>
                            <td>{{ entry.object.labelPlural }}</td>
                            <td><code>{{ name }}</code></td>
                            <td><code>data.{{ entry.object.tableName }}</code></td>
                            <td>
                                {{ form_start(entry.restore_form) }}
                                    <button type="submit" class="gv-btn">{{ 'admin.restore'|trans }}</button>
                                {{ form_end(entry.restore_form) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endif %}
{% endblock %}
