{% extends 'base.html.twig' %}

{% set heading = workflow ? workflow.name : 'admin.workflow.new'|trans %}

{% block title %}{{ heading }} · {{ 'admin.workflows'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path(wf ~ 'index') }}">&larr; {{ 'admin.workflows'|trans }}</a></p>
    <h1>{{ heading }}</h1>

    {% if workflow %}
        <p>
            {% if active %}
                {{ 'admin.workflow.active_since'|trans({'%number%': active.number, '%by%': active.activatedBy, '%at%': active.activatedAt|date('Y-m-d H:i')}) }}
            {% else %}
                <span class="gv-muted">{{ 'admin.workflow.not_running'|trans }}</span>
            {% endif %}
            · <a href="{{ path(wf ~ 'versions', {id: workflow.id.toRfc4122}) }}">{{ 'admin.workflow.versions'|trans }}</a>
            · <a href="{{ path(wf ~ 'runs', {id: workflow.id.toRfc4122}) }}">{{ 'admin.workflow.runs'|trans }}</a>
        </p>
        {% if active and draft %}
            <p class="gv-muted">{{ 'admin.workflow.draft_while_active'|trans({'%number%': draft.number}) }}</p>
        {% endif %}
    {% endif %}

    {% if workflow %}
        <nav class="md-tabs" aria-label="{{ 'admin.workflow.editors'|trans }}">
            <a href="{{ path(wf ~ 'edit', {id: workflow.id.toRfc4122}) }}" {{ mode != 'yaml' ? 'aria-current="page"' }}>{{ 'admin.workflow.tab_visual'|trans }}</a>
            <a href="{{ path(wf ~ 'edit', {id: workflow.id.toRfc4122, mode: 'yaml'}) }}" {{ mode == 'yaml' ? 'aria-current="page"' }}>{{ 'admin.workflow.tab_yaml'|trans }}</a>
        </nav>
    {% endif %}

    <div class="md-admin__columns" data-controller="variable-picker">
        <section class="md-admin__section">
            {% if workflow and mode == 'visual' %}
                {{ component('WorkflowEditor', {workflowId: workflow.id.toRfc4122, console: wf_console}) }}
            {% else %}
            {% if workflow and mode == 'unreadable' %}<p class="md-problems">{{ 'admin.workflow.yaml_unreadable'|trans }}</p>{% endif %}
            {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {{ form_row(form.definition, {attr: {'data-variable-picker-target': 'input'}}) }}
                {% if problems is not empty %}
                    <ul class="md-problems">
                        {% for problem in problems %}
                            <li>{% if problem[0] %}<code>{{ problem[0] }}</code>: {% endif %}{{ problem[1] }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if workflow %}
                    {{ form_widget(form.save) }}
                    {{ form_widget(form.activate) }}
                    {% if form.test is defined %}
                        <div class="md-workflow-test">
                            {{ form_row(form.test_record) }}
                            {{ form_widget(form.test) }}
                        </div>
                    {% endif %}
                {% else %}
                    <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.workflow.create'|trans }}</button>
                {% endif %}
            {{ form_end(form) }}

            {% endif %}
            {% if webhook|default(null) %}
                {# Its address: shown once, when made (a flash); here only whether there is one. #}
                <div class="md-workflow-webhook">
                    <h3>{{ 'admin.workflow.webhook'|trans }}</h3>
                    <p class="gv-muted">
                        {{ webhook.made
                            ? 'admin.workflow.webhook_has'|trans({'%when%': webhook.made.made_at|slice(0, 16), '%who%': webhook.made.made_by ?? '—'})
                            : 'admin.workflow.webhook_none'|trans }}
                    </p>
                    {{ form_start(webhook.form, {attr: {class: 'md-inline-form', 'data-turbo-confirm': webhook.made ? 'admin.workflow.webhook_confirm'|trans : false}}) }}
                        <button type="submit" class="gv-btn">{{ (webhook.made ? 'admin.workflow.webhook_remake' : 'admin.workflow.webhook_make')|trans }}</button>
                    {{ form_end(webhook.form) }}
                </div>
            {% endif %}
            {% if workflow %}
                {% if active %}
                    {{ form_start(deactivate_form, {attr: {class: 'md-inline-form'}}) }}
                        <button type="submit" class="gv-btn">{{ 'admin.workflow.deactivate'|trans }}</button>
                    {{ form_end(deactivate_form) }}
                {% endif %}
                {{ form_start(delete_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'admin.workflow.delete_confirm'|trans({'%name%': workflow.name})}}) }}
                    <button type="submit" class="gv-btn gv-btn-danger">{{ 'admin.delete'|trans }}</button>
                {{ form_end(delete_form) }}
            {% endif %}
        </section>

        <section class="md-admin__section">
            <h2>{{ 'admin.workflow.variables'|trans }}</h2>
            <p class="gv-muted">{{ 'admin.workflow.variables_help'|trans|raw }}</p>
            {% for group, list in {('admin.workflow.variables_trigger'): paths.trigger, ('admin.workflow.variables_context'): paths.context} %}
                <h3>{{ group|trans }}</h3>
                <p class="md-variables">
                    {% for path in list %}<button type="button" class="gv-btn gv-btn-sm" data-action="variable-picker#insert" data-variable-picker-path-param="{{ path }}">{{ path }}</button> {% endfor %}
                </p>
            {% endfor %}
            {% if paths.steps is not empty %}
                <h3>{{ 'admin.workflow.variables_steps'|trans }}</h3>
                {% for key, list in paths.steps %}
                    <p class="md-variables">
                        {% for path in list %}<button type="button" class="gv-btn gv-btn-sm" data-action="variable-picker#insert" data-variable-picker-path-param="{{ path }}">{{ path }}</button> {% endfor %}
                    </p>
                {% endfor %}
            {% endif %}

            <h2>{{ 'admin.workflow.reference'|trans }}</h2>
            <p class="gv-muted">{{ 'admin.workflow.reference_help'|trans|raw }}</p>
            <dl class="md-facts">
                {% for object in objects %}
                    <dt><code>{{ object.name }}</code></dt>
                    <dd>{{ object.fields|keys|join(', ') }}</dd>
                {% endfor %}
            </dl>
        </section>
    </div>
    {% if test %}{{ include('admin/_workflow_test.html.twig', {test: test}) }}{% endif %}
{% endblock %}
