{% extends 'base.html.twig' %}

{% set heading = definition ? definition.label : 'New form' %}

{% block title %}{{ heading }} · Forms{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_form_index') }}">&larr; Forms</a></p>
    <h1>{{ heading }}{% if definition %} <span class="gv-muted">· <code>{{ definition.name }}</code></span>{% endif %}</h1>

    {% if definition %}
        <p><a href="{{ path('composite_new', {form: definition.name}) }}">Open the form</a></p>
    {% endif %}

    <div class="md-admin__columns">
        <section class="md-admin__section">
            {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="gv-btn gv-btn-primary">Save</button>
            {{ form_end(form) }}

            {% if delete_form is defined %}
                {{ form_start(delete_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'Delete the form ' ~ definition.name ~ '? Its records stay.'}}) }}
                    <button type="submit" class="gv-btn gv-btn-danger">Delete</button>
                {{ form_end(delete_form) }}
            {% endif %}
        </section>

        <section class="md-admin__section">
            <h2>Languages</h2>
            <p class="gv-muted">
                The labels here are the texts of the default language; translate them under
                <a href="{{ path('admin_translation_index') }}">Translations</a>. A layout shows a text of its own with a
                <code>{t:name}</code> token, e.g. <code>&lt;legend&gt;{t:sign_in}&lt;/legend&gt;</code>: create the text first, under
                <a href="{{ path('admin_text_index') }}">Texts</a>.
            </p>
        </section>

        <section class="md-admin__section">
            <h2>Objects and relations</h2>
            <p class="gv-muted">A section names an <code>object</code> and the relation field (<code>via</code>) by which it points at the object of its parent.</p>
            <dl class="md-facts">
                {% for object in objects %}
                    <dt><code>{{ object.name }}</code></dt>
                    <dd>
                        {{ object.fields|keys|join(', ') }}
                        {% for name, field in object.fields %}
                            {% if field.relation %}<br><span class="gv-muted">via <code>{{ name }}</code> → {{ field.relation.target }}</span>{% endif %}
                        {% endfor %}
                    </dd>
                {% endfor %}
            </dl>
        </section>
    </div>
{% endblock %}
