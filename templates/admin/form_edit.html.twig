{% extends 'base.html.twig' %}

{% set heading = definition ? definition.label : 'admin.composite.new'|trans %}

{% block title %}{{ heading }} · {{ 'admin.forms'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_form_index') }}">&larr; {{ 'admin.forms'|trans }}</a></p>
    <h1>{{ heading }}{% if definition %} <span class="gv-muted">· <code>{{ definition.name }}</code></span>{% endif %}</h1>

    {% if definition %}
        <p><a href="{{ path('composite_new', {form: definition.name}) }}">{{ 'admin.composite.open_form'|trans }}</a></p>
    {% endif %}

    <div class="md-admin__columns">
        <section class="md-admin__section">
            {{ form_start(form, {attr: {class: 'md-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.save'|trans }}</button>
            {{ form_end(form) }}

            {% if delete_form is defined %}
                {{ form_start(delete_form, {attr: {class: 'md-delete-form', 'data-turbo-confirm': 'admin.composite.delete_confirm'|trans({'%name%': definition.name})}}) }}
                    <button type="submit" class="gv-btn gv-btn-danger">{{ 'admin.delete'|trans }}</button>
                {{ form_end(delete_form) }}
            {% endif %}
        </section>

        <section class="md-admin__section">
            <h2>{{ 'admin.composite.languages'|trans }}</h2>
            <p class="gv-muted">
                {{ 'admin.composite.languages_help'|trans({'%translations%': path('admin_translation_index')|e, '%texts%': path('admin_text_index')|e})|raw }}
            </p>
        </section>

        <section class="md-admin__section">
            <h2>{{ 'admin.composite.objects_relations'|trans }}</h2>
            <p class="gv-muted">{{ 'admin.composite.objects_relations_help'|trans|raw }}</p>
            <dl class="md-facts">
                {% for object in objects %}
                    <dt><code>{{ object.name }}</code></dt>
                    <dd>
                        {{ object.fields|keys|join(', ') }}
                        {% for name, field in object.fields %}
                            {# "via" is the key of the YAML definition: not translated. #}
                            {% if field.relation %}<br><span class="gv-muted">via <code>{{ name }}</code> → {{ field.relation.target }}</span>{% endif %}
                        {% endfor %}
                    </dd>
                {% endfor %}
            </dl>
        </section>
    </div>
{% endblock %}
