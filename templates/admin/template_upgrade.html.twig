{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.template_admin.upgrade_title'|trans({'%template%': template}) }} · {{ 'admin.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_template_index') }}">&larr; {{ 'admin.templates'|trans }}</a></p>
    <h1>
        {%- if preview -%}
            {{ 'admin.template_admin.upgrade_heading_versions'|trans({'%template%': template|e, '%from%': preview.from|e, '%to%': preview.to|e})|raw }}
        {%- else -%}
            {{ 'admin.template_admin.upgrade_heading'|trans({'%template%': template|e})|raw }}
        {%- endif -%}
    </h1>

    {% if reasons is not empty %}
        <div class="md-flash md-flash--error" role="alert">
            <p>{{ 'admin.template_admin.cannot_upgrade'|trans }}</p>
            <ul>{% for reason in reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    {% if preview and choices %}
        <h2>{{ 'admin.template_admin.changes'|trans }}</h2>
        {% if preview.changes is empty %}
            <p class="gv-muted">{{ 'admin.template_admin.only_conflicts'|trans }}</p>
        {% else %}
            <ul class="md-link-list">{% for change in preview.changes %}<li>{{ change }}</li>{% endfor %}</ul>
        {% endif %}

        {{ form_start(choices, {attr: {class: 'md-form md-form--wide'}}) }}
            {% if preview.conflicts is not empty %}
                <h2>{{ 'admin.template_admin.conflicts'|trans }}</h2>
                <p class="gv-muted">{{ 'admin.template_admin.conflicts_help'|trans }}</p>
                {% for conflict in preview.conflicts %}
                    <fieldset>
                        <legend>{{ conflict.description }}</legend>
                        {% if conflict.here is not null or conflict.there is not null %}
                            <div class="md-columns">
                                <div><strong>{{ 'admin.template_admin.here'|trans }}</strong><pre>{{ conflict.here ?? 'admin.template_admin.removed_here'|trans }}</pre></div>
                                <div><strong>{{ 'admin.template_admin.new_version'|trans }}</strong><pre>{{ conflict.there ?? 'admin.template_admin.removed_there'|trans }}</pre></div>
                            </div>
                        {% endif %}
                        {{ form_widget(choices['c' ~ loop.index0]) }}
                    </fieldset>
                {% endfor %}
            {% endif %}
            {{ form_rest(choices) }}
            {% if reasons is empty %}
                <button type="submit" class="gv-btn gv-btn-primary">{{ 'admin.template_admin.upgrade_button'|trans({'%version%': preview.to}) }}</button>
            {% endif %}
        {{ form_end(choices) }}
    {% endif %}
{% endblock %}
