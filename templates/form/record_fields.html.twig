{#
  Controls of the record forms that Symfony has no block for, on top of the bundle's gv theme
  (config/packages/twig.yaml).
#}

{#- A row of a many-to-many field going through a junction object (JunctionRowType): the
    junction's fields, then its hidden id. Gridview's collection control draws the rest of the
    row (its fieldset, its errors, its "×") and the rows around it. -#}
{%- block junction_row_widget -%}
    {{- form_widget(form.values) }}{{ form_widget(form.id) -}}
{%- endblock junction_row_widget %}
