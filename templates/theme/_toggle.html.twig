{# The light / dark toggle: the moon shows in the light theme, the sun in the dark one (CSS).
   For a signed-in user a form, sent in the background to save the choice in the profile.
   floating: pinned to the top right corner, on a page without the top bar. #}
{% set label = 'nav.theme'|trans %}
{% set class = 'md-theme' ~ (floating|default(false) ? ' md-theme--floating') %}
{% set icons %}
    <svg class="md-theme__icon md-theme__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    <svg class="md-theme__icon md-theme__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
{% endset %}
{% if app.user %}
    <form class="md-theme-form" method="post" action="{{ path('app_account_theme') }}"
          data-controller="theme-toggle" data-action="theme-toggle#toggle">
        {# Stateless CSRF: the csrf-protection controller turns the token into a double-submit cookie. #}
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
        <input type="hidden" name="theme" data-theme-toggle-target="theme">
        <button type="submit" class="{{ class }}" aria-label="{{ label }}" title="{{ label }}">{{ icons }}</button>
    </form>
{% else %}
    <button type="button" class="{{ class }}" data-controller="theme-toggle" data-action="theme-toggle#toggle"
            aria-label="{{ label }}" title="{{ label }}">{{ icons }}</button>
{% endif %}
