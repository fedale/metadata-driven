<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# A page's own: a refresh while the worker has its subject (a background import). #}
        {% block meta %}{% endblock %}
        <title>{% block title %}Metadata-driven{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>◆</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body data-gv-scope>
        <header class="md-topbar">
            {% if app.request.attributes.get('_system_console') %}
                {# The system console: the system's, no workspace's navigation (whose
                   permission checks would find no RBAC tables). #}
                <a href="{{ path('console_index') }}" class="md-topbar__brand">{{ 'console.title'|trans }}</a>
                {% if app.user %}
                    <nav class="md-topbar__nav">
                        <a href="{{ path('console_index') }}">{{ 'console.workspaces'|trans }}</a>
                        <a href="{{ path('console_indexes') }}">{{ 'console.indexes'|trans }}</a>
                        <a href="{{ path('console_workflow_index') }}">{{ 'console.workflows'|trans }}</a>
                    </nav>
                    <div class="md-topbar__user">
                        <a href="{{ path('app_account') }}" title="{{ 'nav.account'|trans }}">{{ app.user.displayName }}</a>
                        <a href="{{ path('app_logout') }}">{{ 'nav.sign_out'|trans }}</a>
                    </div>
                {% endif %}
            {% else %}
            <a href="{{ path('app_home') }}" class="md-topbar__brand">Metadata-driven</a>
            {% if app.user %}
                <nav class="md-topbar__nav">
                    <a href="{{ path('app_home') }}">{{ 'nav.records'|trans }}</a>
                    {% if can('admin.metadata') %}<a href="{{ path('admin_index') }}">{{ 'nav.admin'|trans }}</a>{% endif %}
                    {% if can('admin.members') %}<a href="{{ path('admin_member_index') }}">{{ 'nav.members'|trans }}</a>{% endif %}
                    {% if can('admin.roles') %}<a href="{{ path('admin_role_index') }}">{{ 'nav.roles'|trans }}</a>{% endif %}
                </nav>
                <div class="md-topbar__user">
                    {% if app.enabled_locales|length > 1 %}
                        <form class="md-locale" method="post" action="{{ path('app_account_locale') }}" aria-label="{{ 'nav.language'|trans }}">
                            {# Stateless CSRF: the csrf-protection controller turns the token into a double-submit cookie. #}
                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                            {% for locale in app.enabled_locales %}
                                <button type="submit" name="locale" value="{{ locale }}" lang="{{ locale }}"
                                        class="md-locale__option{{ locale == app.request.locale ? ' md-locale__option--current' }}"
                                        title="{{ locale|locale_name(locale)|capitalize }}"
                                        {% if locale == app.request.locale %}aria-current="true"{% endif %}>{{ locale|upper }}</button>
                            {% endfor %}
                        </form>
                    {% endif %}
                    {% set workspaces = workspace_links(app.user.id) %}
                    {% if workspaces is not empty %}
                        <nav class="md-workspaces" aria-label="{{ 'nav.workspaces'|trans }}">
                            {% for workspace in workspaces %}
                                <a href="{{ workspace.url }}" class="md-workspaces__option{{ workspace.current ? ' md-workspaces__option--current' }}"
                                   {% if workspace.current %}aria-current="true"{% endif %}>{{ workspace.name }}</a>
                            {% endfor %}
                        </nav>
                    {% endif %}
                    {# The bell: the count of the unread, the latest in a menu loaded when it opens
                       (a lazy Turbo Frame), the count asked again every minute. #}
                    {% set unread = unread_notifications() %}
                    <details class="md-bell" data-controller="notification-bell"
                             data-notification-bell-url-value="{{ path('notification_count') }}">
                        <summary class="md-bell__toggle" aria-label="{{ 'notifications.title'|trans }}" title="{{ 'notifications.title'|trans }}">
                            <svg class="md-bell__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg>
                            <span class="md-bell__count" data-notification-bell-target="count"{% if unread == 0 %} hidden{% endif %}>{{ unread }}</span>
                        </summary>
                        <div class="md-bell__menu">
                            <turbo-frame id="notification-menu" src="{{ path('notification_menu') }}" loading="lazy"></turbo-frame>
                        </div>
                    </details>
                    <a href="{{ path('app_account') }}" title="{{ 'nav.account'|trans }}">{{ app.user.displayName }}</a>
                    <a href="{{ path('app_logout') }}">{{ 'nav.sign_out'|trans }}</a>
                </div>
            {% endif %}
            {% endif %}
        </header>
        <main class="md-page">
            {% for message in app.flashes('success') %}
                <p class="md-flash md-flash--success" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="md-flash md-flash--error" role="alert">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
