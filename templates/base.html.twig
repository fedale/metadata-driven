<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Metadata-driven{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>◆</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body data-gv-scope>
        <header class="md-topbar">
            <a href="{{ path('app_home') }}" class="md-topbar__brand">Metadata-driven</a>
            {% if app.user %}
                <nav class="md-topbar__nav">
                    <a href="{{ path('app_home') }}">{{ 'nav.records'|trans }}</a>
                    {% if can('admin.metadata') %}<a href="{{ path('admin_index') }}">{{ 'nav.admin'|trans }}</a>{% endif %}
                    {% if can('admin.members') %}<a href="{{ path('admin_member_index') }}">{{ 'nav.members'|trans }}</a>{% endif %}
                </nav>
                <div class="md-topbar__user">
                    {% if app.enabled_locales|length > 1 %}
                        <form class="md-locale" method="post" action="{{ path('app_account_locale') }}" aria-label="{{ 'nav.language'|trans }}">
                            {# Stateless CSRF: the csrf-protection controller turns the token into a double-submit cookie. #}
                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                            {% for locale in app.enabled_locales %}
                                <button type="submit" name="locale" value="{{ locale }}" lang="{{ locale }}"
                                        class="md-locale__option{{ locale == app.request.locale ? ' md-locale__option--current' }}"
                                        title="{{ locale|locale_name(locale)|capitalize }}"
                                        {% if locale == app.request.locale %}aria-current="true"{% endif %}>{{ locale|upper }}</button>
                            {% endfor %}
                        </form>
                    {% endif %}
                    {% set tenants = tenant_links(app.user.id) %}
                    {% if tenants is not empty %}
                        <nav class="md-tenants" aria-label="{{ 'nav.tenants'|trans }}">
                            {% for tenant in tenants %}
                                <a href="{{ tenant.url }}" class="md-tenants__option{{ tenant.current ? ' md-tenants__option--current' }}"
                                   {% if tenant.current %}aria-current="true"{% endif %}>{{ tenant.name }}</a>
                            {% endfor %}
                        </nav>
                    {% endif %}
                    <span>{{ app.user.displayName }}</span>
                    <a href="{{ path('app_logout') }}">{{ 'nav.sign_out'|trans }}</a>
                </div>
            {% endif %}
        </header>
        <main class="md-page">
            {% for message in app.flashes('success') %}
                <p class="md-flash md-flash--success" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="md-flash md-flash--error" role="alert">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
