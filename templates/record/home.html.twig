{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'home.title'|trans }}</h1>
    {% if objects is empty %}
        {% if can_administer %}
            <p class="gv-muted">{{ 'home.empty_admin'|trans({'%url%': path('admin_object_new')})|raw }}</p>
        {% else %}
            <p class="gv-muted">{{ 'home.empty'|trans }}</p>
        {% endif %}
    {% else %}
        <ul class="md-link-list">
            {% for object in objects %}
                <li><a href="{{ path('record_index', {object: object.name}) }}">{{ object.labelPlural }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if forms is not empty %}
        <h2>{{ 'home.forms'|trans }}</h2>
        <ul class="md-link-list">
            {% for form in forms %}
                <li><a href="{{ path('composite_new', {form: form.name}) }}">{{ form.label }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
