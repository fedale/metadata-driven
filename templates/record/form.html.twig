{% extends 'base.html.twig' %}

{% set heading = record ? 'Edit ' ~ object.labelSingular|lower : 'New ' ~ object.labelSingular|lower %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    <p><a href="{{ path('record_index', {object: object.name}) }}">&larr; {{ object.labelPlural }}</a></p>
    <h1>{{ heading }}</h1>

    {{ form_start(form, {attr: {class: 'record-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% if layout|default(null) %}
            <div class="record-layout">{{ record_form_layout(form, layout) }}</div>
        {% endif %}
        {{ form_rest(form) }}
        <p class="muted required-legend"><span class="required-mark">*</span> Required field</p>
        {% if record is null or can_update|default(false) %}
            <button type="submit" class="button">Save</button>
        {% endif %}
    {{ form_end(form) }}

    {% for group in referencing|default([]) %}
        <section class="related">
            <h2>{{ group.label }} <span class="muted">({{ group.total }})</span></h2>
            <ul>
                {% for related in group.records %}
                    <li><a href="{{ path('record_edit', {object: group.objectName, id: related.id}) }}">{{ related.label }}</a></li>
                {% endfor %}
            </ul>
            {% if group.total > group.records|length %}
                <p class="muted">Showing {{ group.records|length }} of {{ group.total }}.</p>
            {% endif %}
        </section>
    {% endfor %}

    {% if delete_form is defined and can_delete|default(false) %}
        {{ form_start(delete_form, {attr: {class: 'delete-form', 'data-turbo-confirm': 'Delete this ' ~ object.labelSingular|lower ~ '?'}}) }}
            <button type="submit" class="button button-danger">Delete</button>
        {{ form_end(delete_form) }}
    {% endif %}
{% endblock %}
