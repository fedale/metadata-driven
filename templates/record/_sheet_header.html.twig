{# The header of a form page: where it belongs, its title, and its actions, kept in view. #}
<header class="md-sheet__header">
    <div>
        {% if crumb is defined and crumb %}
            <p class="md-sheet__crumb">
                {% if crumb_url %}<a href="{{ crumb_url }}">{{ crumb }}</a>{% else %}{{ crumb }}{% endif %}
            </p>
        {% endif %}
        <h1 class="md-sheet__title">{{ title }}</h1>
    </div>
    <div class="md-sheet__actions">
        {# For an administrator: the machine names next to the labels, for the {name} tokens of
           the layouts (machine-names controller, on the form). #}
        {% if can('admin.metadata') %}
            <button type="button" class="gv-btn md-sheet__machine-names" aria-pressed="false"
                    data-machine-names-target="toggle" data-action="machine-names#toggle">{{ 'form.machine_names'|trans }}</button>
        {% endif %}
        <a class="gv-btn" href="{{ back }}">{{ 'form.cancel'|trans }}</a>
        {% if can_save %}
            <button type="submit" class="gv-btn gv-btn-primary">{{ 'form.save'|trans }}</button>
            {# After "Save" in the markup, so Enter in a field keeps saving plainly (the browser
               submits with the first submit button); the stylesheet shows it before "Save". #}
            {% if can_save_new|default(false) %}
                <button type="submit" class="gv-btn md-sheet__save-new" name="_action" value="save_new">{{ 'form.save_and_new'|trans }}</button>
            {% endif %}
        {% endif %}
    </div>
</header>
