{% extends 'base.html.twig' %}

{% block title %}{{ object.labelPlural }}{% endblock %}

{% block body %}
    <div class="md-page__header">
        {% set grid_views = object.views|filter(v => v.kind.value == 'grid')|sort((a, b) => b.isDefault <=> a.isDefault) %}
        {% if grid_views|length > 1 %}
            {# The grid views of the object, the default one first: it opens at /o/<object>. #}
            <nav class="md-switch" aria-label="{{ 'record.grid_views'|trans }}">
                {% for view in grid_views %}
                    <a class="md-switch__item{{ grid_view and grid_view.name == view.name ? ' md-switch__item--current' : '' }}"
                       href="{{ view.isDefault ? path('record_index', {object: object.name}) : path('record_grid', {object: object.name, grid: view.name}) }}"
                       {{ grid_view and grid_view.name == view.name ? 'aria-current="page"' : '' }}>{{ view.name|replace({'_': ' '})|capitalize }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        <div class="md-page__actions" data-controller="gridview-ui-settings"
             data-gridview-ui-settings-url-value="{{ path('fedale_gridview_ui_settings') }}"
             data-gridview-ui-settings-grid-value="{{ gridview.id }}">
            {% if can_create %}
                <a class="gv-btn gv-btn-primary" href="{{ path('record_new', {object: object.name}) }}">{{ 'record.new'|trans({'%object%': object.labelSingular|lower}) }}</a>
                <a class="gv-btn" href="{{ path('record_import', {object: object.name}) }}">{{ 'import.button'|trans }}</a>
            {% endif %}
            {% if can('admin.metadata') %}
                <button type="button" class="gv-btn" data-action="gridview-ui-settings#open">
                    {{ 'ui_settings.menu'|trans({}, 'GridviewBundle') }}
                </button>
                {% include '@FedaleGridview/ui_settings/_modal.html.twig' %}
            {% endif %}
        </div>
    </div>

    {# The grid renders its own title (display.title), toolbar, filters and pagination. #}
    {% include '@FedaleGridview/gridview/_grid.html.twig' with {
        gridview: gridview,
        columns: columns,
        models: models,
        pagination: pagination,
        form: form is defined ? form : null,
    } %}
{% endblock %}
