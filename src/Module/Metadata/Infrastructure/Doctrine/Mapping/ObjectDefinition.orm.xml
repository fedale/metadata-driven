<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Module\Metadata\Domain\Model\ObjectDefinition" table="metadata_object" schema="core">
        <unique-constraints>
            <unique-constraint name="uniq_metadata_object_name" columns="name"/>
            <unique-constraint name="uniq_metadata_object_table_name" columns="table_name"/>
        </unique-constraints>

        <id name="id" type="uuid"/>

        <field name="name" length="50"/>
        <field name="tableName" length="63"/>
        <field name="labelSingular" length="100"/>
        <field name="labelPlural" length="100"/>
        <field name="icon" length="50" nullable="true"/>
        <field name="isSystem" type="boolean"/>
        <field name="isActive" type="boolean"/>
        <field name="labelField" length="50" nullable="true"/>
        <field name="searchHandler" length="50" nullable="true"/>
        <field name="searchFields" type="json" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="uniqueTogether" type="json" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="updatedAt" type="datetime_immutable"/>

        <one-to-many field="fields" target-entity="App\Module\Metadata\Domain\Model\FieldDefinition" mapped-by="object" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>
        <one-to-many field="views" target-entity="App\Module\Metadata\Domain\Model\ViewDefinition" mapped-by="object" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
