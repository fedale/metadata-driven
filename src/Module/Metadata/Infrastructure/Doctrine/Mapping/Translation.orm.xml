<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Module\Metadata\Domain\Model\Translation" table="metadata_translation" schema="core">
        <unique-constraints>
            <unique-constraint name="uniq_metadata_translation_locale_key" columns="locale,message_key"/>
        </unique-constraints>

        <id name="id" type="uuid"/>

        <field name="locale" length="10"/>
        <field name="key" column="message_key" length="255"/>
        <field name="text" type="text"/>
        <field name="updatedAt" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
