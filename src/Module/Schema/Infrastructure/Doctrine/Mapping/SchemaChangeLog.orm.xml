<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Module\Schema\Domain\Model\SchemaChangeLog" table="schema_change_log" schema="core">
        <indexes>
            <index name="idx_schema_change_log_object" columns="object_name"/>
        </indexes>

        <id name="id" type="uuid"/>

        <field name="objectName" length="50"/>
        <field name="tableName" length="120"/>
        <field name="statements" type="json">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="skipped" type="json">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="appliedAt" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
